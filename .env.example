VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_LEGAL_ENTITY_NAME=
VITE_LEGAL_ENTITY_ADDRESS=
VITE_LEGAL_ENTITY_PHONE=
VITE_LEGAL_REGISTRATION_ID=
VITE_PRIVACY_CONTACT_EMAIL=
VITE_SUPPORT_EMAIL=
VITE_PREMIUM_PRICE_DISPLAY=
VITE_FIREBASE_AI_MODEL=gemini-3.8-flash
# Required when the client is hosted separately from the Express API.
VITE_API_BASE_URL=
# Server-only values (never prefix secrets with VITE_)
GEMINI_API_KEY=
# Optional OpenAI-compatible provider used by the AI question pipeline.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# AI Question Engine model overrides (defaults are defined in ai-config.ts)
AI_MODEL_QUESTION_PLANNER=
AI_MODEL_QUESTION_GENERATOR=
AI_MODEL_QUESTION_VALIDATOR=
# Firestore lease for durable AI jobs. Workers renew it every minute; 2–30 min.
AI_JOB_LEASE_MS=300000
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
# Production API requests require a valid Firebase App Check token by default.
# Set false only for controlled local/emulator environments.
ENFORCE_APP_CHECK=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://zekapark.muratteknofest.chatgpt.site
# Admin dashboard question-bank target; informational only.
QUESTION_LIBRARY_TARGET=500
# Short network grace after the authoritative exam timer reaches zero.
EXAM_SUBMISSION_GRACE_SECONDS=120
# Legal identity is mandatory in production. Use the registered legal entity,
# not a product/team nickname.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_PHONE=
LEGAL_REGISTRATION_ID=
PRIVACY_CONTACT_EMAIL=
SUPPORT_EMAIL=
# At least 32 random characters; used only by the audited deletion worker to
# pseudonymise retained compliance proofs after all subject data is erased.
PRIVACY_AUDIT_HMAC_KEY=
ACTIVITY_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
AI_LOG_RETENTION_DAYS=365
PRIVACY_REQUEST_RETENTION_DAYS=1095
# Payments remain fail-closed until a reviewed merchant account and server-only
# Stripe credentials are configured.
PAYMENTS_ENABLED=false
STRIPE_LIVE_MODE_REQUIRED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PREMIUM_PRICE_DISPLAY=
