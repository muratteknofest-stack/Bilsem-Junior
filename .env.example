VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_AI_MODEL=gemini-3.8-flash
# Required when the client is hosted separately from the Express API.
VITE_API_BASE_URL=
# Server-only values (never prefix secrets with VITE_)
GEMINI_API_KEY=
# Optional OpenAI-compatible provider used by the AI question pipeline.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# AI Question Engine model overrides (defaults are defined in ai-config.ts)
AI_MODEL_QUESTION_PLANNER=
AI_MODEL_QUESTION_GENERATOR=
AI_MODEL_QUESTION_VALIDATOR=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
# Production API requests require a valid Firebase App Check token by default.
# Set false only for controlled local/emulator environments.
ENFORCE_APP_CHECK=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://zekapark.muratteknofest.chatgpt.site
# Admin dashboard question-bank target; informational only.
QUESTION_LIBRARY_TARGET=500
