rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      // Administrative authority is issued and revoked only by a trusted
      // backend through Firebase custom claims. Email addresses are identity
      // attributes, never authorization rules.
      return hasRole('admin') &&
        request.auth.token.firebase is map &&
        request.auth.token.firebase.sign_in_second_factor is string;
    }

    function isParent() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isLinkedParent(userId) {
      return isParent() &&
        get(/databases/$(database)/documents/users/$(userId)).data.linkedParentId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isLinkedParent(userId) || isAdmin();

      // Profiles are provisioned atomically by the trusted family-registration
      // API after guardian consent. Browsers cannot create standalone children.
      allow create: if false;

      // Identity, authorization, entitlements, scores and progress are written
      // only by trusted backend services. Browsers may update presentation and
      // study-preference fields only.
      allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'grade', 'avatar', 'lastLoginAt',
            'dailyGoalMinutes', 'dailyGoalQuestions', 'dailyGoalSessions',
            'soundEnabled', 'reminderConfig', 'featuredBadgeIds', 'updatedAt'
          ]);
      // Account deletion is an audited backend workflow so Auth, child data,
      // billing references and Firestore roots cannot become orphaned.
      allow delete: if false;

      match /private/{documentId} {
        allow read: if isOwner(userId) || isLinkedParent(userId) || isAdmin();
        allow write: if false;
      }
    }

    match /questions/{questionId} {
      // Question documents include answer keys and editorial metadata. Student
      // delivery is performed only by the trusted challenge API, which strips
      // answers before returning a question.
      allow read: if isAdmin();
      // Editorial mutations are audited by the MFA-protected Admin SDK API;
      // even an administrator browser cannot bypass revision/idempotency checks.
      allow write: if false;
    }

    match /practiceSessions/{sessionId} {
      allow read: if isOwner(resource.data.userId) || isLinkedParent(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /mistakeQuestionVault/{userId}/{document=**} {
      // Contains complete retry questions and answer keys. Even the owner must
      // obtain a redacted challenge through the trusted practice API.
      allow read, write: if false;
    }

    match /testAttempts/{attemptId} {
      allow read: if isOwner(resource.data.userId) || isLinkedParent(resource.data.userId) || isAdmin();
      allow write: if false;

      match /questions/{questionId} {
        // Answer keys are never readable by browser clients, including the
        // attempt owner. The trusted scoring service uses Admin SDK access.
        allow read, write: if false;
      }
    }

    match /entitlements/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /billingCheckouts/{documentId} {
      allow read, write: if false;
    }

    match /billingEvents/{documentId} {
      allow read, write: if false;
    }

    match /progressEvents/{documentId} {
      // Append-only learning evidence is created by the trusted scoring API.
      allow read, write: if false;
    }

    match /privacyDeletionRequests/{documentId} {
      allow read: if (signedIn() && resource.data.requesterId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
