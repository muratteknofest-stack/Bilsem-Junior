rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin') && request.auth.token.email_verified == true;
    }

    function isParent() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isLinkedParent(userId) {
      return isParent() &&
        get(/databases/$(database)/documents/users/$(userId)).data.linkedParentId == request.auth.uid;
    }

    function validInitialParentLink(userId) {
      return request.resource.data.linkedStudentIds is list &&
        request.resource.data.linkedStudentIds.size() == 1 &&
        get(/databases/$(database)/documents/users/$(request.resource.data.linkedStudentIds[0])).data.linkedParentId == userId;
    }

    function validAccountIdentity(userId, role) {
      return request.resource.data.id == userId &&
        request.resource.data.role == role &&
        request.auth.token.email is string &&
        request.resource.data.email == request.auth.token.email;
    }

    function validConsent(role) {
      return request.resource.data.consent is map &&
        request.resource.data.consent.actorRole == role &&
        request.resource.data.consent.acceptedAt is int &&
        request.resource.data.consent.kvkkVersion is string &&
        request.resource.data.consent.termsVersion is string;
    }

    function validProgressDeltas() {
      let oldXp = resource.data.get('xp', 0);
      let newXp = request.resource.data.get('xp', 0);
      let oldStreak = resource.data.get('streak', 0);
      let newStreak = request.resource.data.get('streak', 0);
      return newXp >= oldXp &&
        (newXp - oldXp <= 200) &&
        newStreak >= 0 &&
        (newStreak <= oldStreak + 1);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isLinkedParent(userId) || isAdmin();

      // Each browser account can only create its own non-admin profile. A family
      // account is accepted only after the linked student created their own
      // profile and explicitly points back to the parent UID.
      allow create: if isAdmin() ||
        (isOwner(userId) &&
          (
          (validAccountIdentity(userId, 'student') &&
            validConsent(request.resource.data.keys().hasAny(['linkedParentId']) ? 'parent' : 'student') &&
            !request.resource.data.keys().hasAny(['linkedStudentIds']) &&
            (!request.resource.data.keys().hasAny(['linkedParentId']) ||
              request.resource.data.linkedParentId is string)) ||
          (validAccountIdentity(userId, 'parent') &&
            validConsent('parent') &&
            !request.resource.data.keys().hasAny(['linkedParentId']) &&
            validInitialParentLink(userId))
          ));

      // Identity, authorization and family-link fields cannot be changed by a browser client.
      // Progress increments are bounded to prevent client-side score manipulation.
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'grade', 'avatar', 'level', 'xp', 'streak', 'longestStreak', 'lastActiveDate', 'lastLoginAt',
            'todayPracticed', 'streakFreezeCount', 'claimedStreakDays',
            'weeklyStreakHistory', 'dailyGoalMinutes', 'todayMinutesSpent',
            'dailyGoalQuestions', 'todayQuestionsSolved', 'dailyGoalSessions',
            'todaySessionsCompleted', 'soundEnabled', 'totalQuestionsSolved',
            'resolvedMistakesCount', 'featuredBadgeIds', 'reminderConfig', 'updatedAt'
          ]) &&
          validProgressDeltas());
      allow delete: if isOwner(userId) || isAdmin();

      match /private/{documentId} {
        allow read: if isOwner(userId) || isLinkedParent(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /practiceSessions/{sessionId} {
      allow read: if isOwner(resource.data.userId) || isLinkedParent(resource.data.userId) || isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() ||
        (isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /testAttempts/{attemptId} {
      allow read: if isOwner(resource.data.userId) || isLinkedParent(resource.data.userId) || isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() ||
        (isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
