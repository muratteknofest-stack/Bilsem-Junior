{
  "name": "zekapark",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "build:client": "npm run typecheck && vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "build:ops": "esbuild scripts/enforce-retention.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=build/ops/enforce-retention.js",
    "build": "npm run build:client && npm run build:server && npm run build:ops",
    "start": "node build/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "npm run typecheck",
    "test": "node --import tsx --test tests/adaptive-engine.test.ts tests/editorial-engine.test.ts tests/question-engine.test.ts tests/security-regression.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-zekapark-rules \"node --import tsx --test tests/firestore-rules.test.ts\"",
    "security:audit": "node scripts/osv-audit.mjs",
    "security:audit:all": "OSV_INCLUDE_DEV=true node scripts/osv-audit.mjs",
    "ops:secure-admin": "tsx scripts/secure-admin.ts",
    "ops:verify-admin": "tsx scripts/verify-admin-security.ts",
    "ops:enable-mfa": "tsx scripts/enable-totp-mfa.ts",
    "ops:retention": "tsx scripts/enforce-retention.ts",
    "ops:privacy-approve": "tsx scripts/approve-privacy-deletion.ts",
    "ops:privacy-delete": "tsx scripts/process-privacy-deletion.ts",
    "ops:migrate-answer-secrets": "tsx scripts/migrate-answer-secrets.ts",
    "release:validate": "node scripts/validate-release-config.mjs",
    "deploy:production": "bash scripts/deploy-production.sh",
    "ops:configure-app-check": "bash scripts/configure-app-check.sh",
    "ops:configure-production": "bash scripts/configure-production-ops.sh",
    "ops:restore-drill": "bash scripts/restore-drill.sh",
    "check": "npm test && npm run test:rules && npm run build"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.1.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.6",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.10",
    "openai": "^6.49.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "firebase-tools": "15.30.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
