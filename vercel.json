{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=:path*" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/feed.xml", "destination": "/blog/feed.xml" },
    { "source": "/blog/:slug", "destination": "/blog/:slug/index.html" },
    { "source": "/((?!api/|blog(?:/|$)|blog-assets/|robots\\.txt$|sitemap\\.xml$).*)", "destination": "/index.html" }
  ]
}

